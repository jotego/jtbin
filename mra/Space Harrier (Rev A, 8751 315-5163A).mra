        <dip name="Lives" bits="10,11" ids="5,4,2,3"/>
        <dip name="Bonus Life" bits="12" ids="7M,5M"/>
        <dip name="Trial Time" bits="13" ids="On,Off"/>
        <dip name="Difficulty" bits="14,15" ids="Hardest,Hard,Easy,Medium"/>
