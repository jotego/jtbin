    <rom index="0" zip="sharrier.zip" md5="None" asm_md5="84c7403d2b6e3bbec2e64af60da55c04">
        <!-- 
  0[0]: i8751      i8751 MCU
  0[1]: fd1089     FC1089B
  0[2]: blank4     IPL2 set at blank
  1[0]: ym2151     YM2151
  2[0]: cab1p      1P at bit 6
  3[0]: hicol      6144 colors
4[2:0]: adc        ADC channels -->
        <part>
            01 00 00 00 02 00 00 00
        </part>
        <!-- maincpu - starts at 0x0 - length 0x40000 (18 bits) -->
        <interleave output="16">
            <part name="epr-7184a.ic84" crc="e1934a51" map="01"/>
            <part name="epr-7188a.ic97" crc="45e173c3" map="10"/>
