<misterromdescription>
    <about author="jotego" webpage="https://patreon.com/jotego" twitter="@topapate" source="https://jotego/jtcores"/>
    <rotation>horizontal</rotation>
    <name>Meikyu Jima (Japan)</name>
    <setname>kikcubic</setname>
    <mameversion>0282</mameversion>
    <year>1988</year>
    <manufacturer>Irem</manufacturer>
    <players>2</players>
    <rbf>jtmeikyu</rbf>
    <joystick>4</joystick>
    <region>World</region>
    <rom index="0" zip="kikcubic.zip" md5="None" asm_md5="af6ea7b6ad9aeb40f7c0d001c42de38d">
        <!-- maincpu - starts at 0x0 - length 0x28000 (18 bits) -->
        <part name="mqj-p0" crc="9cef394a"/>
        <part name="mqj-b0" crc="d9bcf4cd"/>
        <part name="mqj-b1" crc="54a0abe1"/>
        <!-- JTFRAME_BA1_START -->
        <!-- soundcpu - starts at 0x28000 - length 0x10000 (16 bits) -->
        <part name="mqj-sp" crc="bbcf3582"/>
        <!-- PCM_START -->
        <!-- m72 - starts at 0x38000 - length 0x10000 (16 bits) -->
        <part name="mqj-v0" crc="54762956"/>
        <!-- JTFRAME_BA2_START -->
        <!-- chars - starts at 0x48000 - length 0x40000 (18 bits) -->
        <interleave output="16">
            <part name="mqj-c0" crc="975585c5" map="01"/>
            <part name="mqj-c1" crc="49d9936d" map="10"/>
        </interleave>
        <part repeat="0x20000"> FF</part>
        <!-- JTFRAME_BA3_START -->
        <!-- sprites - starts at 0x88000 - length 0x80000 (19 bits) -->
        <interleave output="16">
            <part name="mqj-00" crc="7fb0c58f" map="01"/>
            <part name="mqj-10" crc="3a189205" map="10"/>
        </interleave>
        <!-- Total 0x108000 bytes - 1056 kBytes -->
    </rom>
    <rom index="17" zip="jtbeta.zip" md5="None" asm_md5="7ecc1117032b37ba8a571c5a05db418c">
        <part name="beta.bin" crc="3df60dfd"/>
    </rom>
    <nvram index="2" size="6148"/>
    <rom index="1">
        <part>00 59</part>
    </rom>
    <switches page_id="1" page_name="Switches" base="16" default="ff,d5">
        <DSW1/>
        <dip name="Difficulty" bits="0,1" ids="Hardest,Hard,Easy,Medium"/>
        <dip name="Lives" bits="2,3" ids="4,2,1,3"/>
        <DSW2/>
        <dip name="Flip Screen" bits="8" ids="On,Off"/>
        <dip name="Cabinet" bits="9" ids="Upright,Cocktail"/>
        <dip name="Demo Sounds" bits="11" ids="On,Off"/>
        <dip name="Level Select" bits="13" ids="On,Off"/>
        <dip name="Player Adding" bits="14" ids="On,Off"/>
        <dip name="Service Mode" bits="15" ids="On,Off"/>
    </switches>
    <buttons names="Freeze,Pillar,Start,Coin,Core credits,Test,Service" default="A,B,Start,Select,L2,R2,L3" count="2"/>
</misterromdescription>
