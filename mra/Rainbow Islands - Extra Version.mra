<misterromdescription>
    <about author="jotego" webpage="https://patreon.com/jotego" twitter="@topapate" source="https://jotego/jtcores"/>
    <rotation>horizontal</rotation>
    <name>Rainbow Islands - Extra Version</name>
    <setname>rbislande</setname>
    <mameversion>0282</mameversion>
    <year>1988</year>
    <manufacturer>Taito Corporation</manufacturer>
    <players>2</players>
    <rbf>jtrastan</rbf>
    <joystick>2</joystick>
    <region>World</region>
    <rom index="0" zip="rbislande.zip|cchip.zip" md5="None" address="0x30000000" asm_md5="67381419e7122c563c346cc67ddf16e4">
        <!-- 
  0[0]: rastan     Rastan hardware
  0[1]: opwolf     Operation Wolf hardware
  0[2]: rbisland   Rainbow Islands
  0[3]: cchip      C-chip present
1[7:0]: gun_xoff8  Light-gun X offset (signed)
2[7:0]: gun_yoff8  Light-gun Y offset (signed) -->
        <part>
            0C 00 00 00 00 00 00 00
        </part>
        <!-- maincpu - starts at 0x0 - length 0x80000 (19 bits) -->
        <interleave output="16">
            <part name="b39-02.20" crc="4dead71f" map="01"/>
            <part name="b39-01.19" crc="50690880" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="b39-04.22" crc="4caa53bd" map="01"/>
            <part name="b39-03.21" crc="4a4cb785" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="b22-04.24" crc="91625e7f" map="01"/>
            <part name="b22-03.23" crc="3ebb0fb8" map="10"/>
        </interleave>
        <!-- JTFRAME_BA1_START -->
        <!-- audiocpu - starts at 0x80000 - length 0x10000 (16 bits) -->
        <part name="b22-14.43" crc="113c1a5b"/>
        <!-- PCM_START -->
        <!-- adpcm - starts at 0x90000 - length 0x80000 (19 bits) -->
        <part repeat="0x80000"> FF</part>
        <!-- JTFRAME_BA2_START -->
        <!-- pc080sn - starts at 0x110000 - length 0x80000 (19 bits) -->
        <interleave output="16">
            <part name="b22-01.2" crc="b76c9168" map="12"/>
        </interleave>
        <!-- JTFRAME_BA3_START -->
        <!-- pc090oj - starts at 0x190000 - length 0xF0000 (20 bits) -->
        <interleave output="16">
            <part name="b22-02.5" crc="1b87ecf0" map="12"/>
        </interleave>
        <interleave output="16">
            <part name="b22-13.6" crc="2fda099f" map="01"/>
            <part name="b22-12.7" crc="67a76dc6" map="10"/>
        </interleave>
        <part repeat="0x50000"> FF</part>
        <!-- JTFRAME_PROM_START -->
        <!-- cchip_bios - starts at 0x280000 - length 0x1000 (12 bits) -->
        <part name="cchip_upd78c11.bin" crc="43021521" length="0x1000"/>
        <!-- cchip_eprom - starts at 0x281000 - length 0x2000 (13 bits) -->
        <part name="cchip_b39-05.53" crc="397735e3" length="0x2000"/>
        <!-- Total 0x283000 bytes - 2572 kBytes -->
    </rom>
    <rom index="17" zip="jtbeta.zip" md5="None" asm_md5="5a2b1e5d0672c729eee562b43e70cc7f">
        <part name="beta.bin" crc="8b6976d8"/>
    </rom>
    <nvram index="2" size="77857"/>
    <rom index="1">
        <part>00 80</part>
    </rom>
    <switches page_id="1" page_name="Switches" base="16" default="fe,bf">
        <DSWA/>
        <dip name="Cabinet" bits="0" ids="Upright,Cocktail"/>
        <dip name="Flip Screen" bits="1" ids="On,Off"/>
        <dip name="Service Mode" bits="2" ids="On,Off"/>
        <dip name="Demo Sounds" bits="3" ids="Off,On"/>
        <dip name="Coin A" bits="4,5" ids="2/3,2/1,1/2,1/1"/>
        <dip name="Coin B" bits="6,7" ids="1/6,1/4,1/3,1/2"/>
        <DSWB/>
        <dip name="Difficulty" bits="8,9" ids="Hardest,Hard,Easy,Medium"/>
        <dip name="1PUP" bits="10" ids="None,100k 1000k"/>
        <dip name="Complete Bonus" bits="11" ids="100k,1 Up"/>
        <dip name="Lives" bits="12,13" ids="2,1,4,3"/>
        <dip name="Language" bits="14" ids="English,Japanese"/>
        <dip name="Coin Mode" bits="15" ids="Mode B,Mode A"/>
    </switches>
    <buttons names="button 1,button 2,Start,Coin,Core credits" default="A,B,Start,Select,-" count="2"/>
</misterromdescription>
