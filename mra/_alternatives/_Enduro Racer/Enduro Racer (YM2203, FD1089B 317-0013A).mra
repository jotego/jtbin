        <interleave output="16">
            <part name="epr-7633.ic1" crc="6f146210" offset="0x0000" map="01" length="0x4000"/>
            <part name="epr-7633.ic1" crc="6f146210" offset="0x4000" map="10" length="0x4000"/>
        </interleave>
        <!-- ZOOM_START -->
        <!-- sprites:zoom - starts at 0x1D0000 - length 0x2000 (13 bits) -->
        <part name="epr-6844.ic123" crc="e3ec7bd6"/>
        <!-- JTFRAME_PROM_START -->
        <!-- MCU_START -->
        <!-- mcu - starts at 0x1D2000 - length 0x1000 (12 bits) -->
        <part repeat="0x1000"> FF</part>
        <!-- MAINKEY_START -->
        <!-- maincpu:key - starts at 0x1D3000 - length 0x2000 (13 bits) -->
        <part name="317-0013a.key" crc="a965b2da"/>
