    <rom index="0" zip="enduror1.zip|enduror.zip" md5="None" asm_md5="4f10817d4f2ae30e358a2024dfa573e0">
        <!-- 
  0[0]: i8751      i8751 MCU
  0[1]: fd1089     FC1089B
  0[2]: blank4     IPL2 set at blank
  1[0]: ym2151     YM2151
  2[0]: cab1p      1P at bit 6
  3[0]: hicol      6144 colors
4[2:0]: adc        ADC channels -->
        <part>
            06 00 01 00 04 00 00 00
        </part>
        <!-- maincpu - starts at 0x0 - length 0x40000 (18 bits) -->
        <interleave output="16">
            <part name="epr-7629.ic84" crc="f50f4169" map="01"/>
            <part name="epr-7630.ic97" crc="a1bdadab" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="epr-7637.ic85" crc="82a27a8c" map="01"/>
            <part name="epr-7641.ic98" crc="2503ae7c" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="epr-7638.ic86" crc="70544779" map="01"/>
            <part name="epr-7642.ic99" crc="1c453bea" map="10"/>
        </interleave>
        <part repeat="0x10000"> FF</part>
        <!-- JTFRAME_BA1_START -->
        <!-- subcpu - starts at 0x40000 - length 0x40000 (18 bits) -->
        <interleave output="16">
            <part name="epr-7635.ic67" crc="22f762ab" map="01"/>
            <part name="epr-7634.ic54" crc="3e07fd32" map="10"/>
        </interleave>
        <part repeat="0x30000"> FF</part>
        <!-- SND_START -->
        <!-- soundcpu - starts at 0x80000 - length 0x8000 (15 bits) -->
        <part name="epr-7765.ic73" crc="81c82fc9"/>
        <part name="epr-7764.ic72" crc="755bfdad"/>
        <!-- PCM_START -->
        <!-- pcm - starts at 0x88000 - length 0x20000 (17 bits) -->
        <part name="epr-7762.ic5" crc="bc0c4d12"/>
        <part name="epr-7763.ic6" crc="627b3c8c"/>
        <part repeat="0x10000"> FF</part>
        <!-- JTFRAME_BA2_START -->
        <!-- gfx1 - starts at 0xA8000 - length 0x20000 (17 bits) -->
        <interleave output="32">
            <part name="epr-7644.ic31" crc="e7a4ff90" map="0001"/>
            <part name="epr-7645.ic46" crc="4caa0095" map="0010"/>
            <part name="epr-7646.ic60" crc="7e432683" map="0100"/>
            <part name="epr-7646.ic60" crc="7e432683" map="1000"/>
        </interleave>
        <!-- JTFRAME_BA3_START -->
        <!-- sprites - starts at 0xC8000 - length 0x100000 (20 bits) -->
