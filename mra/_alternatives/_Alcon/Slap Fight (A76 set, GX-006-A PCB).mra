<misterromdescription>
    <about author="jotego" webpage="https://patreon.com/jotego" twitter="@topapate" source="https://jotego/jtcores"/>
    <rotation>vertical (ccw)</rotation>
    <name>Slap Fight (A76 set, GX-006-A PCB)</name>
    <setname>slapfigha</setname>
    <mameversion>0282</mameversion>
    <year>1986</year>
    <manufacturer>Toaplan / Taito</manufacturer>
    <players>2</players>
    <rbf>jtslap</rbf>
    <joystick>8</joystick>
    <region>World</region>
    <rom index="0" zip="slapfigha.zip|alcon.zip" md5="None" asm_md5="437e17ceb9e20639c0e7025102012ae1">
        <!-- Byte 12: bit 0 A76 main-latch screen flip; bit 1 Tiger-Heli fixed ROM, MCU status polarity, main-latch flip and sound divider. -->
        <part>
            00 00 01 00 02 00 05 00
            07 00 07 08 01 00 00 00
        </part>
        <!-- maincpu - starts at 0x0 - length 0x10000 (16 bits) -->
        <part name="a76_00.8p" crc="ac22bb86"/>
        <part name="a76_01.8n" crc="d6b4f02e"/>
        <part name="a76_02.8k" crc="9dd0971f"/>
        <!-- JTFRAME_BA1_START -->
        <!-- audiocpu - starts at 0x10000 - length 0x10000 (16 bits) -->
        <part name="a76_03.12d" crc="87f4705a"/>
        <part repeat="0xE000"> FF</part>
        <!-- JTFRAME_BA2_START -->
        <!-- gfx1 - starts at 0x20000 - length 0x4000 (14 bits) -->
        <interleave output="16">
            <part name="a76_04.6g" crc="3519daa4" map="01"/>
            <part name="a76_05.6f" crc="be9a1bc5" map="10"/>
        </interleave>
        <!-- SCR_START -->
        <!-- gfx2 - starts at 0x24000 - length 0x2C000 (18 bits) -->
        <interleave output="32">
            <part name="a76_06.6p" crc="974e2ea9" map="0001"/>
            <part name="a76_07.6n" crc="5faeeea3" map="0010"/>
            <part name="a76_08.6m" crc="e92d9d60" map="0100"/>
            <part name="a76_09.4m" crc="b6358305" map="1000"/>
        </interleave>
        <part repeat="0xC000"> FF</part>
        <!-- JTFRAME_BA3_START -->
        <!-- gfx3 - starts at 0x50000 - length 0x20000 (17 bits) -->
        <interleave output="32">
            <part name="a76_10.6h" crc="587113ae" map="0001"/>
            <part name="a76_11.8h" crc="422d946b" map="0010"/>
            <part name="a76_12.6j" crc="b1b7b925" map="0100"/>
            <part name="a76_13.8j" crc="8545d397" map="1000"/>
        </interleave>
        <!-- JTFRAME_PROM_START -->
        <!-- mcu - starts at 0x70000 - length 0x800 (11 bits) -->
        <part name="a76_14.6a" crc="3f4980bb"/>
        <!-- PAL_START -->
        <!-- proms - starts at 0x70800 - length 0x720 (11 bits) -->
        <part name="a76-17.12q" crc="a0efaf99"/>
        <part name="a76-15.12m" crc="a56d57e5"/>
        <part name="a76-16.12n" crc="5cbf9fbf"/>
        <part name="14_82s129.2c" crc="4dc04453"/>
        <part name="15_82s129.8b" crc="48ac3db4"/>
        <part name="16_82s129.1e" crc="59490887"/>
        <part name="17_82s129.1c" crc="d492e6c2"/>
        <part name="18_82s123.2b" crc="aa0ca5a5"/>
        <!-- Total 0x70F20 bytes - 451 kBytes -->
    </rom>
    <nvram index="2" size="10244"/>
    <!-- Vertical screen. Orientation reversed. -->
    <rom index="1">
        <part>05 80</part>
    </rom>
    <switches page_id="1" page_name="Switches" base="16" default="7f,ff">
        <DSW1/>
        <dip name="Coin B" bits="0,1" ids="2/3,1/2,2/1,1/1"/>
        <dip name="Coin A" bits="2,3" ids="2/3,1/2,2/1,1/1"/>
        <dip name="Demo Sounds" bits="4" ids="Off,On"/>
        <dip name="Screen Test" bits="5" ids="On,Off"/>
        <dip name="Flip Screen" bits="6" ids="On,Off"/>
        <dip name="Cabinet" bits="7" ids="Upright,Cocktail"/>
        <DSW2/>
        <dip name="Service Mode" bits="9" ids="On,Off"/>
        <dip name="Lives" bits="10,11" ids="2,5,1,3"/>
        <dip name="Bonus Life" bits="12,13" ids="100k,50k 200k,50k,30k 100k"/>
        <dip name="Difficulty" bits="14,15" ids="Hardest,Easy,Hard,Medium"/>
    </switches>
    <buttons names="Fire,Select,Start,Coin,Core credits" default="A,B,Start,Select,-" count="2"/>
</misterromdescription>
