<misterromdescription>
    <about author="jotego" webpage="https://patreon.com/jotego" twitter="@topapate" source="https://jotego/jtcores"/>
    <rotation>horizontal</rotation>
    <name>Sky Kid (old version)</name>
    <setname>skykido</setname>
    <mameversion>0282</mameversion>
    <year>1985</year>
    <manufacturer>Namco</manufacturer>
    <players>2</players>
    <rbf>jtskykid</rbf>
    <joystick>8</joystick>
    <region>World</region>
    <rom index="0" zip="skykido.zip|skykid.zip" md5="None" asm_md5="78ed7164147c16f28a9eb1cb6a4aa172">
        <!-- 
  1[0]: rot180     Rotate the output 180 degrees -->
        <part>
            00 01 00 00 00 00 00 00
        </part>
        <!-- maincpu - starts at 0x0 - length 0xC000 (16 bits) -->
        <part name="sk2_2.6c" crc="ea8a5822"/>
        <part name="sk1_1.6b" crc="070a49d4"/>
        <part name="sk1_3.6d" crc="314b8765"/>
        <!-- JTFRAME_BA1_START -->
        <!-- mcusub - starts at 0xC000 - length 0x2000 (13 bits) -->
        <part name="sk2_4.3c" crc="a460d0e0"/>
        <!-- JTFRAME_BA2_START -->
        <!-- chars - starts at 0xE000 - length 0x2000 (13 bits) -->
        <part name="sk1_6.6l" crc="58b731b9"/>
        <!-- BG_START -->
        <!-- tiles - starts at 0x10000 - length 0x2000 (13 bits) -->
        <part name="sk1_5.7e" crc="c33a498e"/>
        <!-- JTFRAME_BA3_START -->
        <!-- sprites - starts at 0x12000 - length 0x10000 (16 bits) -->
        <interleave output="16">
            <part name="sk1_8.10n" crc="44bb7375" map="01" length="0x2000"/>
            <part name="sk1_7.10m" crc="3454671d" map="10" length="0x2000"/>
        </interleave>
        <interleave output="16">
            <part name="sk1_8.10n" crc="44bb7375" map="01" length="0x2000" offset="0x2000"/>
            <part name="sk1_7.10m" crc="3454671d" map="10" length="0x2000"/>
        </interleave>
        <interleave output="16">
            <part name="sk1_7.10m" crc="3454671d" map="01" length="0x2000" offset="0x2000"/>
            <part name="sk1_7.10m" crc="3454671d" map="10" length="0x2000"/>
        </interleave>
        <interleave output="16">
            <part name="sk1_7.10m" crc="3454671d" map="01" length="0x2000" offset="0x2000"/>
            <part name="sk1_7.10m" crc="3454671d" map="10" length="0x2000"/>
        </interleave>
        <!-- JTFRAME_PROM_START -->
        <!-- mcu - starts at 0x22000 - length 0x1000 (12 bits) -->
        <part name="cus63-63a1.mcu" crc="6ef08fb3"/>
        <!-- proms - starts at 0x23000 - length 0x700 (11 bits) -->
        <part name="sk1-1.2n" crc="0218e726"/>
        <part name="sk1-2.2p" crc="fc0d5b85"/>
        <part name="sk1-3.2r" crc="d06b620b"/>
        <part name="sk1-4.5n" crc="c697ac72"/>
        <part name="sk1-5.6n" crc="161514a4"/>
        <!-- Total 0x23700 bytes - 141 kBytes -->
    </rom>
    <nvram index="2" size="14336"/>
    <rom index="1">
        <part>00 80</part>
    </rom>
    <switches page_id="1" page_name="Switches" base="16" default="ff,ff,ff">
        <DSWA/>
        <dip name="Coin B" bits="0,1" ids="3/1,2/1,1/2,1/1"/>
        <dip name="Freeze" bits="2" ids="On,Off"/>
        <dip name="Round Skip" bits="3" ids="On,Off"/>
        <dip name="Demo Sounds" bits="4" ids="Off,On"/>
        <dip name="Coin A" bits="5,6" ids="3/1,2/1,1/2,1/1"/>
        <dip name="Service Mode" bits="7" ids="On,Off"/>
        <DSWB/>
        <dip name="Flip Screen" bits="8" ids="On,Off"/>
        <dip name="Allow Buy In" bits="9" ids="No,Yes"/>
        <dip name="Bonus Life" bits="12,13" ids="20k every 80k,20k and 80k,30k every 90k,30k and 90k"/>
        <dip name="Lives" bits="14,15" ids="5,2,1,3"/>
    </switches>
    <buttons names="Shot,Loop,Start,Coin,Core credits" default="A,B,Start,Select,-" count="2"/>
</misterromdescription>
