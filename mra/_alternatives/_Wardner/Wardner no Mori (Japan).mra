<misterromdescription>
    <about author="jotego" webpage="https://patreon.com/jotego" twitter="@topapate" source="https://jotego/jtcores"/>
    <rotation>horizontal</rotation>
    <name>Wardner no Mori (Japan)</name>
    <setname>wardnerj</setname>
    <mameversion>0282</mameversion>
    <year>1987</year>
    <manufacturer>Toaplan / Taito Corporation</manufacturer>
    <players>2</players>
    <rbf>jtwardnr</rbf>
    <joystick>8</joystick>
    <region>World</region>
    <rom index="0" zip="wardnerj.zip|wardner.zip|fshark.zip" md5="None" asm_md5="f139fbecad24c4b5abf118431da72b46">
        <!-- maincpu - starts at 0x0 - length 0x40000 (18 bits) -->
        <part name="b25-17.6m" crc="4164dca9"/>
        <part repeat="0x8000"> FF</part>
        <part name="b25-18.7m" crc="9aab8ee2"/>
        <part name="b25-19.8m" crc="95b68813"/>
        <part repeat="0x8000"> FF</part>
        <part name="b25-20.10m" crc="1113ad38"/>
        <!-- JTFRAME_BA1_START -->
        <!-- audiocpu - starts at 0x40000 - length 0x8000 (15 bits) -->
        <part name="b25-16.4k" crc="e5202ff8"/>
        <!-- DSP_START -->
        <!-- dsp - starts at 0x48000 - length 0x1000 (12 bits) -->
        <interleave output="16">
            <part name="d70012u_gxc-02_mcu_71001" crc="eee0ff59" map="12"/>
        </interleave>
        <part repeat="0x400"> FF</part>
        <!-- JTFRAME_BA2_START -->
        <!-- chars - starts at 0x49000 - length 0x10000 (16 bits) -->
        <interleave output="32">
            <part name="b25-07.10f" crc="50e329e0" map="0001"/>
            <part name="b25-06.8f" crc="3bfeb6ae" map="0010"/>
            <part name="b25-05.7f" crc="be36a53e" map="0100"/>
            <part name="b25-05.7f" crc="be36a53e" map="1000"/>
        </interleave>
        <!-- BG_START -->
        <!-- bg_tiles - starts at 0x59000 - length 0x20000 (17 bits) -->
        <interleave output="32">
            <part name="b25-08.12f" crc="883ccaa3" map="0001"/>
            <part name="b25-11.16f" crc="d6ebd510" map="0010"/>
            <part name="b25-10.15f" crc="b9a61e81" map="0100"/>
            <part name="b25-09.14f" crc="585411b7" map="1000"/>
        </interleave>
        <!-- FG_START -->
        <!-- fg_tiles - starts at 0x79000 - length 0x20000 (17 bits) -->
        <interleave output="32">
            <part name="b25-12.18f" crc="15d08848" map="0001"/>
            <part name="b25-15.23f" crc="cdd2d408" map="0010"/>
            <part name="b25-14.21f" crc="5a2aef4f" map="0100"/>
            <part name="b25-13.19f" crc="be21db2b" map="1000"/>
        </interleave>
        <!-- JTFRAME_BA3_START -->
        <!-- obj - starts at 0x99000 - length 0x40000 (18 bits) -->
        <interleave output="32">
            <part name="b25-01.14c" crc="42ec01fb" map="0001"/>
            <part name="b25-02.16c" crc="6c0130b7" map="0010"/>
            <part name="b25-03.17c" crc="b923db99" map="0100"/>
            <part name="b25-04.19c" crc="8059573c" map="1000"/>
        </interleave>
        <!-- JTFRAME_PROM_START -->
        <!-- proms - starts at 0xD9000 - length 0x260 (10 bits) -->
        <part name="82s129.b19" crc="24e7d62f"/>
        <part name="82s129.b18" crc="a50cef09"/>
        <part name="82s123.b21" crc="f72482db"/>
        <part name="82s123.c6" crc="bc88cced"/>
        <part name="82s123.f1" crc="4fb5df2a"/>
        <!-- Total 0xD9260 bytes - 868 kBytes -->
    </rom>
    <rom index="17" zip="jtbeta.zip" md5="None" asm_md5="7ecc1117032b37ba8a571c5a05db418c">
        <part name="beta.bin" crc="3df60dfd"/>
    </rom>
    <rom index="1">
        <part>00 80</part>
    </rom>
    <switches page_id="1" page_name="Switches" base="16" default="01,00">
        <DSWA/>
        <dip name="Cabinet" bits="0" ids="Cocktail,Upright"/>
        <dip name="Flip Screen" bits="1" ids="Off,On"/>
        <dip name="Service Mode" bits="2" ids="Off,On"/>
        <dip name="Demo Sounds" bits="3" ids="On,Off"/>
        <dip name="Coin A" bits="4,5" ids="1/1,1/2,2/1,2/3"/>
        <dip name="Coin B" bits="6,7" ids="1/1,1/2,2/1,2/3"/>
        <DSWB/>
        <dip name="Difficulty" bits="8,9" ids="Normal,Easy,Hard,Very Hard"/>
        <dip name="Bonus Life" bits="10,11" ids="30k 80k 50k+,50k 100k 50k+,30k Only,50k Only"/>
        <dip name="Lives" bits="12,13" ids="3,4,5,1"/>
    </switches>
    <buttons names="Fire,Jump,Start,Coin,Core credits" default="A,B,Start,Select,-" count="2"/>
