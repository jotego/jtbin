<misterromdescription>
    <about author="jotego,Andrea Bogazzi" webpage="https://patreon.com/jotego" twitter="@topapate" source="https://jotego/jtcores"/>
    <rotation>vertical (ccw)</rotation>
    <name>Twin Hawk (World)</name>
    <setname>twinhawk</setname>
    <mameversion>0282</mameversion>
    <year>1989</year>
    <manufacturer>Taito Corporation Japan</manufacturer>
    <players>2</players>
    <rbf>jttaitox</rbf>
    <joystick>8</joystick>
    <region>World</region>
    <rom index="0" zip="twinhawk.zip|cchip.zip" md5="None" asm_md5="34c4fa9d15cec53b90a0336cf04e987d">
        <!-- 
  0[0]: cchip      Taito P0-039A (C-chip)
  0[1]: ym2151     Taito P0-051A (PC060HA + YM2151) -->
        <part>
            02 00 00 00 00 00 00 00
            00 00 00 00 00 00 00 00
        </part>
        <!-- maincpu - starts at 0x0 - length 0x90000 (20 bits) -->
        <interleave output="16">
            <part name="b87-10.u5" crc="17181706" map="01"/>
            <part name="b87-11.u7" crc="fc84a399" map="10"/>
        </interleave>
        <part repeat="0x50000"> FF</part>
        <!-- JTFRAME_BA1_START -->
        <!-- audiocpu - starts at 0x90000 - length 0x10000 (16 bits) -->
        <part name="b87-07.13e" crc="e2e0efa0"/>
        <part repeat="0x8000"> FF</part>
        <!-- PCM_START -->
        <!-- adpcma - starts at 0xA0000 - length 0x160000 (21 bits) -->
        <part repeat="0x160000"> FF</part>
        <!-- JTFRAME_BA2_START -->
        <!-- gfx1 - starts at 0x200000 - length 0x200000 (21 bits) -->
        <interleave output="16">
            <part name="b87-04.3k" crc="958434b6" map="01"/>
            <part name="b87-02.3h" crc="89ad43a0" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="b87-03.3j" crc="ce155ae0" map="01"/>
            <part name="b87-01.3f" crc="81e82ae1" map="10"/>
        </interleave>
        <!-- JTFRAME_BA3_START -->
        <!-- adpcmb - starts at 0x400000 -->
        <!-- cchip_bios - starts at 0x400000 -->
        <!-- cchip_eprom - starts at 0x400000 -->
        <!-- Total 0x400000 bytes - 4096 kBytes -->
    </rom>
    <rom index="17" zip="jtbeta.zip" md5="None" asm_md5="5a2b1e5d0672c729eee562b43e70cc7f">
        <part name="beta.bin" crc="8b6976d8"/>
    </rom>
    <nvram index="2" size="21504"/>
    <!-- Vertical screen. Orientation reversed. 8-line black frame on top/bottom. -->
    <rom index="1">
        <part>0D 80</part>
    </rom>
    <switches page_id="1" page_name="Switches" base="16" default="ff,7f">
        <DSWA/>
        <dip name="Flip Screen" bits="1" ids="On,Off"/>
        <dip name="Service Mode" bits="2" ids="On,Off"/>
        <dip name="Demo Sounds" bits="3" ids="Off,On"/>
        <dip name="Coin A" bits="4,5" ids="4/1,3/1,2/1,1/1"/>
        <dip name="Coin B" bits="6,7" ids="1/6,1/4,1/3,1/2"/>
        <DSWB/>
        <dip name="Difficulty" bits="8,9" ids="Hardest,Hard,Easy,Medium"/>
        <dip name="Bonus Life" bits="10,11" ids="100k only,50k only,70k &amp; *200k,50k &amp; *150k"/>
        <dip name="Lives" bits="12,13" ids="2,4,5,3"/>
        <dip name="Allow Continue" bits="15" ids="Yes,No"/>
    </switches>
    <buttons names="button 1,button 2,-,Start,Coin,Core credits" default="A,B,Start,Select,-" count="2"/>
</misterromdescription>
